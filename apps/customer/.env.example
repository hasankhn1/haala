# ── Google sign-in ──────────────────────────────────────────────────────────
# Client IDs from the Google Cloud Console. **Not secrets** — they are public
# identifiers, and `EXPO_PUBLIC_` inlines them into the bundle by design. There
# is no client secret anywhere in this app.
#
# The Android one requires your build's SHA-1 fingerprint. Unset, the Google
# button renders disabled with a reason and email sign-in still works.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
