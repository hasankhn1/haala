# Which Haala API this dashboard talks to.
#
# A **bare origin, no /api/v1** — src/lib/session.ts appends the prefix, so
# adding it yourself produces /api/v1/api/v1 and every call 404s.
#
# Copy this file to .env.local and leave the local value in place:
#
#   cp apps/dashboard/.env.example apps/dashboard/.env.local
#
# Next reads env once at boot. If you change this, **restart the dev server** —
# a running one keeps the old value, and the dashboard will keep talking to
# wherever it was pointed when it started. The banner across the top tells you
# when that is not your own machine.
HAALA_API_URL=http://localhost:4000

# Production (set in the hosting provider, not here):
# HAALA_API_URL=https://haala-production.up.railway.app
