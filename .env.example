# ─────────────────────────────  API  ─────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ───────────────────────────  Database  ──────────────────────────
# Docker publishes Postgres on host port 5433 (see POSTGRES_PORT in
# docker-compose) to avoid clashing with a local Postgres on 5432.
DATABASE_URL=postgresql://haala:haala@localhost:5433/haala

# ─────────────────────────────  Redis  ───────────────────────────
# Docker publishes Redis on host port 6380 to avoid clashing with a local
# Redis on 6379.
REDIS_URL=redis://localhost:6380

# ──────────────────────────────  Auth  ───────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
# seconds
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─────────────────────────────  CORS  ────────────────────────────
# comma-separated list of allowed origins, or * for all (dev only)
CORS_ORIGINS=*

# ───────────────────────────  Payments  ──────────────────────────
# which online provider the PaymentProvider registry resolves for
# non-COD payments. "stub" is a safe no-op for local dev.
PAYMENT_ONLINE_PROVIDER=stub
