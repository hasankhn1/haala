# ─────────────────────────────  API  ─────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ───────────────────────────  Database  ──────────────────────────
# Docker publishes Postgres on host port 5433 (see POSTGRES_PORT in
# docker-compose) to avoid clashing with a local Postgres on 5432.
DATABASE_URL=postgresql://haala:haala@localhost:5433/haala

# ─────────────────────────────  Redis  ───────────────────────────
# Docker publishes Redis on host port 6380 to avoid clashing with a local
# Redis on 6379.
REDIS_URL=redis://localhost:6380

# ──────────────────────────────  Auth  ───────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
# seconds
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─────────────────────────────  CORS  ────────────────────────────
# comma-separated list of allowed origins, or * for all (dev only)
CORS_ORIGINS=*

# ───────────────────────────  Payments  ──────────────────────────
# which online provider the PaymentProvider registry resolves for
# non-COD payments. "stub" is a safe no-op for local dev.
PAYMENT_ONLINE_PROVIDER=stub

# ── Safepay (online payments) ───────────────────────────────────────────
# Leave PAYMENT_ONLINE_PROVIDER as `stub` for local dev; set it to `safepay`
# once these are filled in. The provider fails loudly if selected without them
# rather than silently taking payments nowhere.
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
# Used to verify webhook signatures. Must match the value configured in the
# Safepay dashboard, or every webhook is (correctly) rejected.
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com
SAFEPAY_ENVIRONMENT=sandbox

# ── Cloudflare R2 (brand image uploads) ─────────────────────────────────────
# Create the bucket in the Cloudflare dashboard; an object-scoped API token
# cannot create one. Leave these unset and the upload endpoints answer 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=haala
# Only once public access is switched on for the bucket. Unset, images are
# served through the API instead.
R2_PUBLIC_BASE_URL=
